// Cloudflare Worker for palomaliz.com.br (Workers Builds deploys this on every push to master).
// Everything is static except /jiujitsu/api/*, which runs worker/index.js (Chacrinha Jiu-Jitsu API).
// Free plan only: static asset requests are free and unlimited; only API calls count as Worker requests.
{
  "$schema": "https://unpkg.com/wrangler@4.158.0/config-schema.json",
  "name": "paloma-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/jiujitsu/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    // No database_id: Wrangler creates the "chacrinha-jiujitsu" D1 database on the first deploy.
    { "binding": "JJ_DB", "database_name": "chacrinha-jiujitsu" }
  ]
}
